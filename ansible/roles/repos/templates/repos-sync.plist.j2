<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by ansible (repos role) — do NOT edit by hand. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ repos_sync_label }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{ ansible_env.HOME }}/dotfiles/scripts/repos</string>
    <string>sync</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CODE_ROOT</key>
    <string>{{ code_root | expanduser }}</string>
    <key>REPOS_PRIVATE_DIR</key>
    <string>{{ private_dir | expanduser }}</string>
  </dict>
  <!-- Fixed hours, not StartInterval: launchd runs a missed calendar slot when the Mac
       wakes, while an interval stalls during sleep (it ran once in ~22h that way) -->
  <key>StartCalendarInterval</key>
  <array>
{% for hour in repos_sync_hours %}
    <dict><key>Hour</key><integer>{{ hour }}</integer><key>Minute</key><integer>0</integer></dict>
{% endfor %}
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{ ansible_env.HOME }}/Library/Logs/repos-sync.log</string>
  <key>StandardErrorPath</key>
  <string>{{ ansible_env.HOME }}/Library/Logs/repos-sync.log</string>
</dict>
</plist>
