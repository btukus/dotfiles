#!/bin/zsh
#
# repos — keep track of every git repo under $CODE_ROOT and restore them on a
# new machine.
#
#   repos snapshot       rescan $CODE_ROOT and rewrite the manifest
#   repos sync           snapshot, then commit + push the manifest if it changed
#                        (a launchd agent runs this every few hours)
#   repos status [-f]    show work a restore would NOT bring back: uncommitted
#                        changes, unpushed commits, stashes, .env files,
#                        folders outside git, broken worktree links
#                        (-f: `git fetch --prune` first, so branches deleted on
#                        the remote no longer count as pushed)
#   repos restore [-n]   clone every repo/worktree from the manifest that is
#                        missing locally (-n: dry run). Optional path globs
#                        limit it, e.g. `repos restore 'work/*'`
#   repos repair         relink worktrees after moving repos around on disk
#
# Layout inside $CODE_ROOT is free-form: put a repo wherever you like and the
# next snapshot records its path. Both layouts are tracked per repo:
#   bare  — `gbare` style: the repo dir is a bare repo, worktrees live in its wt/
#   clone — a normal checkout (plus any extra worktrees)
#
# The manifest lives in a PRIVATE repo ($REPOS_PRIVATE_DIR) because these
# dotfiles are public and repo/branch names reveal client work.

emulate -L zsh
setopt no_unset pipe_fail extended_glob

CODE_ROOT=${CODE_ROOT:-$HOME/code}
REPOS_PRIVATE_DIR=${REPOS_PRIVATE_DIR:-$HOME/dotfiles-private}
MANIFEST=${REPOS_MANIFEST:-$REPOS_PRIVATE_DIR/repos.conf}
MAX_DEPTH=6
# Directories never worth descending into while looking for repos.
SKIP_DIRS='(node_modules|.next|.nuxt|.turbo|.terraform|.venv|venv|__pycache__|dist|build|target|vendor|Pods)'

typeset -a FOUND_REPOS LOOSE_DIRS LOOSE_FILES STRAY_WORKTREES

die()  { print -u2 -r -- "repos: $*"; exit 1 }
warn() { print -u2 -r -- "repos: $*" }

# relpath <target> <base> — both absolute; target must share an ancestor
# inside CODE_ROOT with base (always true for what we record).
relpath() {
  local target=$1 base=$2 up=
  while [[ $target != $base && $target != $base/* ]]; do
    base=${base:h}; up+=../
  done
  local r
  if [[ $target == $base ]]; then r=${up%/}; else r=$up${target#$base/}; fi
  print -r -- ${r:-.}
}

is_bare() {
  [[ -f $1/HEAD && -d $1/objects && -d $1/refs ]] &&
    [[ $(git -C $1 rev-parse --is-bare-repository 2>/dev/null) == true ]]
}

# walk <dir> <depth>
# Collects repo roots without descending into them. Sets REPLY to "repo" if
# the subtree holds a repo, "files" if it holds files but no repo, else "".
# Non-repo content is reported at the top-most folder that holds no repo
# (LOOSE_DIRS), or as loose files sitting next to repos (LOOSE_FILES).
walk() {
  local dir=$1 depth=$2 sub has_repo=0
  local -a files loose_children
  if [[ -d $dir/.git ]] || is_bare $dir; then
    FOUND_REPOS+=($dir); REPLY=repo; return
  fi
  if [[ -f $dir/.git ]]; then
    # A worktree whose repo is not under CODE_ROOT (or whose link is broken).
    STRAY_WORKTREES+=($dir); REPLY=repo; return
  fi
  files=($dir/*(N.))
  if (( depth < MAX_DEPTH )); then
    for sub in $dir/*(N/); do
      [[ ${sub:t} == ${~SKIP_DIRS} ]] && continue
      walk $sub $((depth + 1))
      case $REPLY in
        repo)  has_repo=1 ;;
        files) loose_children+=($sub) ;;
      esac
    done
  fi
  if (( has_repo )) || [[ $dir == $CODE_ROOT ]]; then
    LOOSE_DIRS+=($loose_children)
    LOOSE_FILES+=($files)
    REPLY=repo
  elif (( ${#files} || ${#loose_children} )); then
    REPLY=files
  else
    REPLY=
  fi
}

discover() {
  [[ -d $CODE_ROOT ]] || die "CODE_ROOT does not exist: $CODE_ROOT"
  CODE_ROOT=${CODE_ROOT:A}
  FOUND_REPOS=() LOOSE_DIRS=() LOOSE_FILES=() STRAY_WORKTREES=()
  walk $CODE_ROOT 0
  FOUND_REPOS=(${(o)FOUND_REPOS})
}

# Prints "<branch>\t<abs path>" for each linked worktree worth recording:
# on a branch, still present, inside CODE_ROOT, and not a throwaway agent
# worktree under .claude/.
linked_worktrees() {
  local repo=$1 line wt= br= prunable=0
  for line in ${(f)"$(git -C $repo worktree list --porcelain 2>/dev/null)"} "worktree <end>"; do
    case $line in
      worktree\ *)
        if [[ -n $wt && -n $br ]] && (( ! prunable )) && [[ $wt != $repo ]] &&
           [[ $wt == $CODE_ROOT/* && $wt != */.claude/* ]]; then
          print -r -- "$br"$'\t'"$wt"
        fi
        wt=${line#worktree }; [[ -e $wt ]] && wt=${wt:A}
        br= prunable=0 ;;
      branch\ refs/heads/*) br=${line#branch refs/heads/} ;;
      prunable*) prunable=1 ;;
    esac
  done
}

cmd_snapshot() {
  discover
  (( ${#FOUND_REPOS} )) || die "no repos found under $CODE_ROOT — refusing to write an empty manifest"

  local tmp=$(mktemp) repo rel key url r br entry
  print -r -- "# Generated by \`repos snapshot\` (~/dotfiles/scripts/repos). Do not edit by hand." > $tmp
  print -r -- "# Paths are relative to \$CODE_ROOT (default ~/code)." >> $tmp
  for repo in $FOUND_REPOS; do
    rel=${repo#$CODE_ROOT/} key="repo.$rel"
    if is_bare $repo; then
      git config -f $tmp $key.layout bare
    else
      git config -f $tmp $key.layout clone
      br=$(git -C $repo branch --show-current 2>/dev/null)
      [[ -n $br ]] && git config -f $tmp $key.branch $br
    fi
    url=$(git -C $repo remote get-url origin 2>/dev/null) && git config -f $tmp $key.url $url
    for r in ${(f)"$(git -C $repo remote 2>/dev/null)"}; do
      [[ $r == origin ]] && continue
      git config -f $tmp --add $key.remote "$r $(git -C $repo remote get-url $r)"
    done
    for entry in ${(of)"$(linked_worktrees $repo)"}; do
      git config -f $tmp --add $key.worktree "${entry%%$'\t'*} $(relpath ${entry#*$'\t'} $repo)"
    done
  done

  # Guard against wiping the manifest, e.g. a fresh machine whose launchd job
  # fires before `repos restore` ran.
  if [[ -f $MANIFEST && -z ${REPOS_FORCE:-} ]]; then
    local old=$(git config -f $MANIFEST --name-only --get-regexp '^repo\..*\.layout$' 2>/dev/null | wc -l)
    if (( ${#FOUND_REPOS} * 2 < old )); then
      rm -f $tmp
      die "snapshot found ${#FOUND_REPOS} repos but the manifest has $old — not overwriting (run \`repos restore\`, or REPOS_FORCE=1 repos snapshot)"
    fi
  fi

  mkdir -p ${MANIFEST:h}
  if [[ -f $MANIFEST ]] && cmp -s $tmp $MANIFEST; then
    rm -f $tmp; print "manifest unchanged (${#FOUND_REPOS} repos)"
  else
    mv $tmp $MANIFEST; print "manifest updated: ${#FOUND_REPOS} repos -> $MANIFEST"
  fi
}

cmd_sync() {
  [[ -d $REPOS_PRIVATE_DIR/.git ]] || die "$REPOS_PRIVATE_DIR is not a git repo (clone your private repo there)"
  git -C $REPOS_PRIVATE_DIR pull --rebase --autostash -q || warn "pull failed; continuing with local copy"
  cmd_snapshot || return
  local f=${MANIFEST#$REPOS_PRIVATE_DIR/}
  if [[ -n $(git -C $REPOS_PRIVATE_DIR status --porcelain -- $f) ]]; then
    git -C $REPOS_PRIVATE_DIR add -- $f &&
      git -C $REPOS_PRIVATE_DIR commit -q -m "repos: snapshot from ${HOST%%.*}" -- $f &&
      git -C $REPOS_PRIVATE_DIR push -q && print "manifest pushed"
  fi
}

manifest_repos() {
  local name
  for name in ${(f)"$(git config -f $MANIFEST --name-only --get-regexp '^repo\..*\.layout$')"}; do
    name=${name#repo.}; print -r -- ${name%.layout}
  done
}

cmd_restore() {
  local dry=0
  [[ ${1:-} == (-n|--dry-run) ]] && { dry=1; shift }
  [[ -f $MANIFEST ]] || die "no manifest at $MANIFEST"
  mkdir -p $CODE_ROOT; CODE_ROOT=${CODE_ROOT:A}

  local rel dest layout url br entry wbr wpath wt pat match failed=0
  run() { print -r -- "  \$ ${(j: :)${(q-)@}}"; (( dry )) || "$@" }
  for rel in ${(f)"$(manifest_repos)"}; do
    if (( $# )); then
      match=0; for pat in "$@"; do [[ $rel == ${~pat} ]] && match=1; done
      (( match )) || continue
    fi
    dest=$CODE_ROOT/$rel
    layout=$(git config -f $MANIFEST repo.$rel.layout)
    url=$(git config -f $MANIFEST repo.$rel.url 2>/dev/null)

    if [[ ! -e $dest ]]; then
      [[ -n $url ]] || { warn "$rel: no origin url recorded, skipping"; failed=1; continue }
      print -r -- "$rel ($layout)"
      if [[ $layout == bare ]]; then
        run git clone --bare $url $dest &&
          run git -C $dest config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*' &&
          run git -C $dest fetch -q origin || { failed=1; continue }
      else
        run git clone $url $dest || { failed=1; continue }
        br=$(git config -f $MANIFEST repo.$rel.branch 2>/dev/null)
        [[ -n $br ]] && { run git -C $dest checkout -q $br || warn "$rel: could not check out $br" }
      fi
      for entry in ${(f)"$(git config -f $MANIFEST --get-all repo.$rel.remote 2>/dev/null)"}; do
        run git -C $dest remote add ${entry%% *} ${entry#* }
      done
    elif ! git -C $dest rev-parse --git-dir &>/dev/null; then
      warn "$rel: exists but is not a git repo, skipping"; failed=1; continue
    fi

    for entry in ${(f)"$(git config -f $MANIFEST --get-all repo.$rel.worktree 2>/dev/null)"}; do
      wbr=${entry%% *} wpath=${entry#* }
      wt=${${:-$dest/$wpath}:a}
      [[ -e $wt ]] && continue
      if (( dry )) && [[ ! -e $dest ]]; then
        run git -C $dest worktree add $wt $wbr; continue
      fi
      if git -C $dest show-ref -q --verify refs/heads/$wbr; then
        run git -C $dest worktree add -q $wt $wbr &&
          { ! git -C $dest show-ref -q --verify refs/remotes/origin/$wbr ||
            run git -C $dest branch -q --set-upstream-to=origin/$wbr $wbr }
      elif git -C $dest show-ref -q --verify refs/remotes/origin/$wbr; then
        run git -C $dest worktree add -q --track -b $wbr $wt origin/$wbr
      else
        warn "$rel: branch '$wbr' is not on origin (never pushed, or merged and deleted) — worktree $wpath skipped"; failed=1
      fi
    done
  done
  (( failed )) && { warn "finished with problems (see above)"; return 1 }
  print "restore complete"
}

cmd_repair() {
  discover
  local repo wt line old
  local -a wts
  for repo in $FOUND_REPOS; do
    # Candidate worktree dirs: inside the repo dir (bare layout), next to it
    # (clone layout), and wherever git's own records say — re-rooted from any
    # old location onto the repo's current parent when the repo was moved.
    wts=($repo/wt/*/.git(N.:h) $repo/*/.git(N.:h) ${repo:h}/*/.git(N.:h) $repo/.claude/worktrees/*/.git(N.:h))
    for line in ${(f)"$(git -C $repo worktree list --porcelain 2>/dev/null)"}; do
      [[ $line == worktree\ * ]] || continue
      wt=${line#worktree }
      [[ -e $wt/.git ]] && wts+=($wt)
    done
    wts=(${(u)wts:#$repo})
    if (( ${#wts} )); then
      if [[ ! -w $repo ]]; then
        print -r -- "${repo#$CODE_ROOT/}: read-only (archived?), skipped — chmod -R u+w it to repair"; continue
      fi
      git -C $repo worktree repair $wts 2>&1 | grep -v -e '^$' -e 'path mismatch' | sed "s|^|${repo#$CODE_ROOT/}: |"
    fi
    # Drop records of worktrees that no longer exist anywhere (e.g. temp dirs).
    git -C $repo worktree prune 2>/dev/null
  done
  print "repair done"
}

cmd_status() {
  local fetch=0
  [[ ${1:-} == (-f|--fetch) ]] && fetch=1
  discover
  local repo rel wt n b issues line p
  local -a lines
  for repo in $FOUND_REPOS; do
    rel=${repo#$CODE_ROOT/} lines=()
    if git -C $repo remote get-url origin &>/dev/null; then
      (( fetch )) && { git -C $repo fetch -q --prune origin 2>/dev/null || lines+=("fetch failed — results may be stale") }
    else
      lines+=("no origin remote — cannot be restored")
    fi

    for b in ${(f)"$(git -C $repo for-each-ref --format='%(refname:short)' refs/heads)"}; do
      n=$(git -C $repo rev-list --count $b --not --remotes 2>/dev/null)
      (( ${n:-0} )) && lines+=("branch $b: $n commit(s) not on any remote")
    done
    n=$(git -C $repo stash list 2>/dev/null | wc -l)
    (( n )) && lines+=("${n// /} stash entr(ies)")

    for line in ${(f)"$(git -C $repo worktree list --porcelain)"}; do
      [[ $line == worktree\ * ]] && wt=${line#worktree }
      [[ $line == prunable* ]] && lines+=("broken worktree link: $wt (moved? run \`repos repair\`)")
    done
    for wt in $repo ${(f)"$(linked_worktrees $repo | cut -f2)"}; do
      is_bare $wt && continue
      n=$(git -C $wt status --porcelain 2>/dev/null | wc -l)
      (( n )) && lines+=("${${wt#$repo}#/}${${wt#$repo}:+: }${n// /} uncommitted change(s)")
      # --directory reports ignored dirs (node_modules/ …) as one entry instead
      # of walking them, which keeps this fast.
      for p in ${(f)"$(git -C $wt ls-files -oi --exclude-standard --directory 2>/dev/null)"}; do
        [[ ${p:t} == .env* ]] && lines+=("secret file on disk (inject from a secrets manager instead): ${${wt#$CODE_ROOT/}}/$p")
      done
    done

    if (( ${#lines} )); then
      print -r -- "● $rel"; print -rl -- "    "${^lines}; issues=1
    fi
  done

  for p in $STRAY_WORKTREES; do
    print -r -- "● ${p#$CODE_ROOT/}: worktree whose repo is outside ~/code or missing"; issues=1
  done
  for p in $LOOSE_DIRS; do
    print -r -- "● ${p#$CODE_ROOT/}/: folder not in git (not restorable)"; issues=1
  done
  for p in $LOOSE_FILES; do
    print -r -- "● ${p#$CODE_ROOT/}: file not in git (not restorable)"; issues=1
  done

  if [[ -f $MANIFEST ]]; then
    for rel in ${(f)"$(manifest_repos)"}; do
      [[ -e $CODE_ROOT/$rel ]] || { print -r -- "○ $rel: in manifest, not on this machine (\`repos restore\`)"; issues=1 }
    done
  fi
  (( ${issues:-0} )) || print "all clear: everything under $CODE_ROOT is pushed and restorable"
}

case ${1:-help} in
  snapshot) cmd_snapshot ;;
  sync)     cmd_sync ;;
  status)   shift; cmd_status "$@" ;;
  restore)  shift; cmd_restore "$@" ;;
  repair)   cmd_repair ;;
  *) sed -n '3,25p' $0 | sed 's/^# \{0,1\}//'; [[ ${1:-help} == (help|-h|--help) ]] ;;
esac
